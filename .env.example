# DeepSeek API key. Used by the captcha agent and the email token agent.
DEEPSEEK_API_KEY=your-api-key

# SAT citas (citas.sat.gob.mx) booking config
CORE_URL=https://citas.sat.gob.mx/datosPersonales
# Your data. The hourly schedule only exists when RFC and EMAIL are set. CURP is optional.
RFC=
CURP=
EMAIL=
# Labels from the site's dropdowns (accents and case are ignored).
# SERVICE_1 is the service the schedule checks.
SERVICE_1=Correccion o cambio de nombre
# Used for both "Entidad Federativa" and "Módulo".
PREFERRED_MODULE=Oficina Virtual

# PushBird webhook URL (https://pushbird.app/pb_...). It embeds the secret — treat it like a password.
PUSHBIRD_WEBHOOK_URL=

# Composio API key, with a Gmail account connected. Used to read the token SAT emails when booking.
COMPOSIO_API_KEY=
# Optional: the Composio user id the Gmail account is connected under (looked up automatically when empty).
COMPOSIO_USER_ID=

# Optional: store runs in Turso instead of the local mastra.db file.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Optional: send traces to the Mastra platform. Without the token, traces stay local.
# MASTRA_PLATFORM_ACCESS_TOKEN=
# MASTRA_PROJECT_ID=

# Optional: set to production to turn off debug captures, which show RFC, CURP
# and email.
# NODE_ENV=production
